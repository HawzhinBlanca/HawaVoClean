{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hawavoclean.local/schemas/release-evidence-entry-v1.json",
  "title": "HawaVoClean release evidence entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sequence",
    "recorded_at",
    "task_id",
    "source_commit",
    "command",
    "tools",
    "inputs",
    "result",
    "outputs",
    "known_limits",
    "previous_entry_sha256",
    "entry_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "sequence": {"type": "integer", "minimum": 1},
    "recorded_at": {"type": "string", "format": "date-time"},
    "task_id": {"type": "string", "pattern": "^T[0-9]+\\.[0-9]+$"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "cwd"],
      "properties": {
        "text": {"type": "string", "minLength": 1},
        "cwd": {"type": "string", "minLength": 1}
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "inputs": {"$ref": "#/$defs/artifacts"},
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "summary"],
      "properties": {
        "status": {"enum": ["passed", "failed", "blocked"]},
        "summary": {"type": "string", "minLength": 1}
      }
    },
    "outputs": {"$ref": "#/$defs/artifacts"},
    "known_limits": {"type": "array", "items": {"type": "string"}},
    "previous_entry_sha256": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      ]
    },
    "entry_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
